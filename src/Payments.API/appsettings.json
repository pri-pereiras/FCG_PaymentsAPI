{
  "ConnectionStrings": { "PaymentsDb": "Data Source=./data/payments-v2.db" },
  "RabbitMq": { "Host": "localhost", "Username": "guest", "Password": "guest", "OrderQueue": "payments-order-placed" },  
  "PaymentSimulation": {
    "GatewayDelayMilliseconds": 150,
    "MaximumAttempts": 3,
    "RetryDelayMilliseconds": 250,
    "Rules": [
      {
        "MinAmount": 0.01,
        "MaxAmount": 499.99,
        "Scenario": "Approved"
      },
      {
        "MinAmount": 500.00,
        "MaxAmount": 699.99,
        "Scenario": "InsufficientFunds"
      },
      {
        "MinAmount": 700.00,
        "MaxAmount": 799.99,
        "Scenario": "InvalidCard"
      },
      {
        "MinAmount": 800.00,
        "MaxAmount": 899.99,
        "Scenario": "GatewayUnavailable"
      },
      {
        "MinAmount": 900.00,
        "MaxAmount": 999.99,
        "Scenario": "Timeout"
      },
      {
        "MinAmount": 1000.00,
        "MaxAmount": 999999.99,
        "Scenario": "LimitExceeded"
      }
    ]
  }  ,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Payments": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning",
      "RabbitMQ": "Warning",
      "System": "Warning"
    }
  }
}
